---
import { stages } from "../../data/workflow";
---

<section id="workflow" class="workflow wrap" aria-labelledby="workflow-heading">
	<div class="section-intro">
		<h2 id="workflow-heading">One idea. A connected workflow.</h2>
		<p>
			Follow a notification-preferences feature from first question to final
			handoff. <span class="example-label">Illustrative example</span>
		</p>
	</div>
	<div class="stage-nav" aria-label="Workflow stages">
		{stages.map((stage, index) => (
			<a
				id={`stage-${stage.id}`}
				href={`#panel-${stage.id}`}
				data-stage={stage.id}
			>
				<span class="stage-number">0{index + 1}</span>
				<span>{stage.name}</span>
				<svg
					viewBox="0 0 24 24"
					width="18"
					height="18"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					aria-hidden="true"
				>
					<path d="M5 12h14m-6-6 6 6-6 6" />
				</svg>
			</a>
		))}
	</div>
	<div class="workbench">
		{stages.map((stage, index) => (
			<section
				class="stage-panel"
				id={`panel-${stage.id}`}
				aria-labelledby={`stage-${stage.id}`}
			>
				<div class="stage-copy">
					<span class="stage-count">
						{String(index + 1).padStart(2, "0")} / 06
					</span>
					<h3>{stage.title}</h3>
					<p>{stage.description}</p>
					<dl>
						<div>
							<dt>Start with</dt>
							<dd>{stage.input}</dd>
						</div>
						<div>
							<dt>Leave with</dt>
							<dd>{stage.output}</dd>
						</div>
					</dl>
					<a class="text-link" href={`/start#example`}>
						Take the example with you <span aria-hidden="true">↗</span>
					</a>
				</div>
				<div class="artifact">
					<div class="artifact-bar">
						<span class="file-icon" aria-hidden="true">
							<svg
								viewBox="0 0 20 20"
								width="18"
								height="18"
								fill="none"
								stroke="currentColor"
								stroke-width="1.2"
							>
								<path d="M5 2.5h6l4 4v11H5zM11 2.5v4h4M7 10h6M7 13h6" />
							</svg>
						</span>
						<code>{stage.file}</code>
						<span class="artifact-type">Markdown</span>
					</div>
					<div class="artifact-body">
						<h4>{stage.heading}</h4>
						<p>{stage.intro}</p>
						<dl class="artifact-rows">
							{stage.rows.map(([label, detail]) => (
								<div>
									<dt>{label}</dt>
									<dd>{detail}</dd>
								</div>
							))}
						</dl>
						{stage.code && <pre><code>{stage.code}</code></pre>}
						<p class="artifact-note">{stage.note}</p>
					</div>
				</div>
			</section>
		))}
	</div>
	<p class="workflow-footnote">
		Use the whole loop for a feature. Take a shorter path for a small fix. Keep
		the context and the checks.
	</p>
</section>
<script>
	const nav = document.querySelector<HTMLElement>(".stage-nav");
	const tabs = Array.from(
		document.querySelectorAll<HTMLAnchorElement>("[data-stage]"),
	);
	const panels = Array.from(
		document.querySelectorAll<HTMLElement>(".stage-panel"),
	);
	if (nav && tabs.length && panels.length) {
		nav.setAttribute("role", "tablist");
		tabs.forEach((tab) => {
			tab.setAttribute("role", "tab");
			tab.setAttribute("aria-controls", `panel-${tab.dataset.stage}`);
		});
		panels.forEach((panel) => {
			panel.setAttribute("role", "tabpanel");
			panel.tabIndex = 0;
		});
		const activate = (index: number, focus = false) => {
			tabs.forEach((tab, i) => {
				tab.setAttribute("aria-selected", String(i === index));
				tab.tabIndex = i === index ? 0 : -1;
			});
			panels.forEach((panel, i) => {
				panel.hidden = i !== index;
			});
			if (focus) tabs[index].focus();
		};
		const initial = tabs.findIndex((tab) => tab.hash === window.location.hash);
		activate(initial >= 0 ? initial : 0);
		tabs.forEach((tab, index) => {
			tab.addEventListener("click", (event) => {
				event.preventDefault();
				activate(index);
			});
			tab.addEventListener("keydown", (event) => {
				let next = index;
				if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
				else if (event.key === "ArrowLeft")
					next = (index + tabs.length - 1) % tabs.length;
				else if (event.key === "Home") next = 0;
				else if (event.key === "End") next = tabs.length - 1;
				else if (event.key === " ") {
					event.preventDefault();
					activate(index);
					return;
				} else return;
				event.preventDefault();
				activate(next, true);
			});
		});
	}
</script>
