{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@components/*": ["src/components/*"],
			"@layouts/*": ["src/layouts/*"],
			"@assets/*": ["src/assets/*"]
		},
		"noUncheckedIndexedAccess": true
	},
	"include": [".astro/types.d.ts", "src/**/*"],
	"exclude": ["dist", "node_modules", ".vercel"]
}
